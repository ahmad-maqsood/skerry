{
  "id": "grok-bot",
  "name": {
    "en": "Grok Bot"
  },
  "description": {
    "en": "Grok Bot quota and weekly cycle"
  },
  "version": "0.1.0",
  "apiVersion": 1,
  "runtime": {
    "command": "grok-bot.exe"
  },
  "permissions": [
    "quota",
    "network",
    "read-home-files"
  ],
  "contributes": [
    "quota"
  ],
  "settings": [
    {
      "key": "token",
      "label": {
        "en": "Access Token (optional override)"
      },
      "type": "secret",
      "default": ""
    },
    {
      "key": "interval",
      "label": {
        "en": "Refresh interval"
      },
      "type": "select",
      "default": "60",
      "options": [
        {
          "value": "60",
          "label": {
            "en": "1 minute"
          }
        },
        {
          "value": "180",
          "label": {
            "en": "3 minutes"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes"
          }
        }
      ]
    }
  ],
  "actions": []
}
