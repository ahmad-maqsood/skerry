{
  "id": "hermes",
  "name": {
    "en": "Hermes Agent"
  },
  "description": {
    "en": "Nous Research Hermes Agent local sessions"
  },
  "version": "0.1.0",
  "apiVersion": 1,
  "runtime": {
    "command": "hermes.exe"
  },
  "permissions": [
    "sessions",
    "read-home-files"
  ],
  "contributes": [
    "sessions"
  ],
  "settings": [
    {
      "key": "sessions_dir",
      "label": {
        "en": "Sessions directory (optional override)"
      },
      "type": "text",
      "default": ""
    },
    {
      "key": "interval",
      "label": {
        "en": "Refresh interval"
      },
      "type": "select",
      "default": "60",
      "options": [
        {
          "value": "30",
          "label": {
            "en": "30 seconds"
          }
        },
        {
          "value": "60",
          "label": {
            "en": "1 minute"
          }
        },
        {
          "value": "300",
          "label": {
            "en": "5 minutes"
          }
        }
      ]
    }
  ],
  "actions": []
}
